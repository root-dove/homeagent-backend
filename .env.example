APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://homeagent:change-me-for-non-local-use@localhost:5432/homeagent
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT_SECONDS=3
SCHEDULER_ENABLED=false
SCHEDULER_POLL_INTERVAL_SECONDS=10
SCHEDULER_BATCH_SIZE=10
QUIET_HOURS_ENABLED=true
QUIET_HOURS_TIMEZONE=Asia/Seoul
QUIET_HOURS_START=23:00
QUIET_HOURS_END=07:00

POSTGRES_DB=homeagent
POSTGRES_USER=homeagent
POSTGRES_PASSWORD=change-me-for-non-local-use
